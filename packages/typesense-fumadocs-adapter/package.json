{
  "name": "typesense-fumadocs-adapter",
  "description": "An adapter to add Typesense-powered search to your Fumadocs site",
  "homepage": "https://github.com/typesense/typesense-fumadocs-adapter",
  "repository": {
    "type": "git",
    "url": "https://github.com/typesense/typesense-fumadocs-adapter.git",
    "directory": "packages/typesense-fumadocs-adapter"
  },
  "bugs": "https://github.com/typesense/typesense-fumadocs-adapter/issues",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.2",
  "keywords": [
    "typesense",
    "documentation-search",
    "search",
    "fumadocs-adapter",
    "fumadocs-plugin",
    "fumadocs",
    "plugin",
    "adapter"
  ],
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": {
        "import": "./dist/client/index.d.mts",
        "require": "./dist/client/index.d.cts"
      },
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsdown": "^0.20.3"
  },
  "peerDependencies": {
    "typescript": ">=5",
    "fumadocs-core": "^16.0.0",
    "fumadocs-ui": "^16.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "typesense": ">=2.1.0"
  }
}
