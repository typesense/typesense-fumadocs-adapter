{
  "name": "typesense-fumadocs-adapter-monorepo",
  "description": "An adapter that adds lightning-fast, typo-tolerant, Typesense-powered search to your Fumadocs site.",
  "type": "module",
  "homepage": "https://github.com/typesense/typesense-fumadocs-adapter",
  "repository": {
    "type": "git",
    "url": "https://github.com/typesense/typesense-fumadocs-adapter.git",
    "directory": "packages/typesense-fumadocs-adapter"
  },
  "bugs": "https://github.com/typesense/typesense-fumadocs-adapter/issues",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "docs-dev": "cd docs && bun dev",
    "docs-build": "cd docs && bun run build",
    "plugin-build": "cd packages/typesense-fumadocs-adapter && bun run build",
    "plugin-publish": "cd packages/typesense-fumadocs-adapter && npm publish",
    "test": "cd packages/typesense-fumadocs-adapter && bun run test",
    "typecheck": "bunx tsc -p packages/typesense-fumadocs-adapter/tsconfig.json --noEmit",
    "test:integration:prepare": "cd docs && bun run build:index",
    "test:integration": "bun run test:integration:prepare && cd packages/typesense-fumadocs-adapter && bun run test:integration"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/bun": "1.4.0"
  }
}
